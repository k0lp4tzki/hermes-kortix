# Copy to .env and change every value marked CHANGE ME.

# Database password for the internal TimescaleDB (CHANGE ME)
POSTGRES_PASSWORD=change-me-db-password

# Key for encrypting stored credentials (AES-256-GCM). At least 16 characters, keep it safe:
# losing it makes stored secrets unreadable. Generate one with:  openssl rand -base64 32  (CHANGE ME)
HERMES_SECRET_KEY=change-me-to-a-long-random-string

# Initial admin account, created on first start only (when no user exists). (CHANGE ME)
HERMES_ADMIN_USER=admin
HERMES_ADMIN_PASSWORD=change-me-admin

# Web UI / API port and bind address
HERMES_PORT=8080
HERMES_BIND=0.0.0.0
# Set to true when serving Hermes behind HTTPS (marks the session cookie Secure)
HERMES_COOKIE_SECURE=false

# Display name of the Docker host Hermes runs on (default: the host's hostname from /proc)
HERMES_HOST_NAME=

# Parallel check executions in the worker
HERMES_WORKER_CONCURRENCY=16

# Data retention (days). Raw metrics are downsampled to 5-minute and 1-hour aggregates.
HERMES_RETENTION_RAW_DAYS=14
HERMES_RETENTION_RESULTS_DAYS=30
HERMES_RETENTION_5M_DAYS=180
HERMES_RETENTION_1H_DAYS=1095
HERMES_RETENTION_EVENTS_DAYS=365

TZ=Europe/Berlin
LOG_LEVEL=info
